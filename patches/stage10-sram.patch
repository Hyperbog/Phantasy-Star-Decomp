 static uint8_t   g_ram[0x2000];     /* 8 KB system RAM ($C000-$DFFF) */
 static int       g_bank[3] = {0,1,2};
 static bool      g_mapper_cm;        /* Codemasters mapper */
+static uint8_t   g_sram[0x8000];    /* optional Sega cartridge SRAM, up to 32 KiB */
+static size_t    g_sram_size = sizeof g_sram;
+static uint8_t   g_mapper_ctl;      /* mirror of $FFFC: $08=SRAM slot 2, $04=SRAM bank */
+static char     *g_sram_path;       /* opt-in persistence; NULL means volatile */
+static bool      g_sram_dirty;
+
+/* The default 32 KiB image covers both mapper-selectable 16 KiB halves.
+ * Existing 8 KiB and 16 KiB battery images are accepted and mirrored at
+ * their physical address-width boundary; saving preserves that file size.
+ * No file is created unless --sram-file is explicitly requested. */
+static size_t sram_index(uint32_t address){
+    return (size_t)(address % g_sram_size);
+}
+
+bool glue_load_sram(const char *path){
+    if (!path || !*path || g_sram_path){
+        fprintf(stderr,"[sram] invalid or duplicate save-file path\n");
+        return false;
+    }
+    size_t n=strlen(path);
+    if (n > 4096){ fprintf(stderr,"[sram] file path too long\n"); return false; }
+    char *owned=(char*)malloc(n+1);
+    if (!owned) return false;
+    memcpy(owned,path,n+1);
+    FILE *f=fopen(path,"rb");
+    if (f){
+        if (fseek(f,0,SEEK_END)!=0){ fclose(f); free(owned); return false; }
+        long len=ftell(f);
+        if (len!=0x2000 && len!=0x4000 && len!=0x8000){
+            fprintf(stderr,"[sram] unsupported file size %ld (expected 8192/16384/32768)\n",len);
+            fclose(f); free(owned); return false;
+        }
+        rewind(f);
+        if (fread(g_sram,1,(size_t)len,f)!=(size_t)len || ferror(f)){
+            fprintf(stderr,"[sram] cannot read cartridge SRAM image\n");
+            fclose(f); free(owned); return false;
+        }
+        fclose(f);
+        g_sram_size=(size_t)len;
+    } else {
+        if (errno!=ENOENT){
+            fprintf(stderr,"[sram] cannot open existing save-file: %s\n",path);
+            free(owned); return false;
+        }
+        memset(g_sram,0xFF,sizeof g_sram);
+        g_sram_size=sizeof g_sram;
+    }
+    g_sram_dirty=false;
+    g_sram_path=owned;
+    return true;
+}
+
+bool glue_flush_sram(void){
+    if (!g_sram_path || !g_sram_dirty) return true;
+    size_t n=strlen(g_sram_path);
+    char *tmp=(char*)malloc(n+5);
+    if (!tmp) return false;
+    memcpy(tmp,g_sram_path,n);
+    memcpy(tmp+n,".tmp",5);
+    FILE *f=fopen(tmp,"wb");
+    bool ok=false;
+    if (f){
+        ok=(fwrite(g_sram,1,g_sram_size,f)==g_sram_size);
+        if (fflush(f)!=0) ok=false;
+        if (fclose(f)!=0) ok=false;
+    }
+    if (ok) ok=(rename(tmp,g_sram_path)==0);
+    if (!ok){
+        fprintf(stderr,"[sram] unable to persist cartridge SRAM to %s\n",g_sram_path);
+        remove(tmp);
+    } else g_sram_dirty=false;
+    free(tmp);
+    return ok;
+}
+
 
